#!/bin/sh
# Prefill the commit message from COMMIT_MESSAGE in the worktree root.
#
# `gen-commit-msg` writes its message to COMMIT_MESSAGE as plain text with
# all review material on `#` comment lines, so the file can be fed to git
# directly. This hook makes a plain `git commit -s` open the editor with it,
# without anyone having to remember the `-t` flag.
#
# The file is not consumed: it stays in the worktree. To avoid replaying an
# already committed message into the next unrelated commit, only a file newer
# than HEAD counts as a pending draft.
#
# $1 = message file, $2 = source (message|template|merge|squash|commit).

[ -n "$2" ] && exit 0

msg="$(git rev-parse --show-toplevel)/COMMIT_MESSAGE"
[ -s "$msg" ] || exit 0

msg_time=$(stat -f %m "$msg" 2>/dev/null || stat -c %Y "$msg" 2>/dev/null)
[ -n "$msg_time" ] || exit 0

head_time=$(git log -1 --format=%ct 2>/dev/null || echo 0)
[ "$msg_time" -gt "$head_time" ] || exit 0

cat "$msg" > "$1"
